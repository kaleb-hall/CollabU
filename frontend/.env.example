# Copy this file to frontend/.env for local development (scripts/setup.sh does it for you).
# Vite only exposes variables that start with VITE_, and they end up in the public bundle,
# so never put a secret here.

# Where the backend API lives. Locally that is Flask on port 5000.
# On Vercel, set it to your Render address, for example https://collabu-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api
