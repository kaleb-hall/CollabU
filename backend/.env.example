# Copy this file to backend/.env for local development (scripts/setup.sh does it for you).
# The flask command reads backend/.env automatically. In production, set these on Render instead.

# Which settings to use: development, testing or production.
# production refuses to start unless SECRET_KEY, JWT_SECRET_KEY, DATABASE_URL and FRONTEND_URL are set.
FLASK_ENV=development

# The file the flask command loads the app from. Leave as is.
FLASK_APP=run.py

# Signs sessions and other secrets. Any long random string. Make one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-for-production

# Signs login tokens. Use a different long random string than SECRET_KEY.
JWT_SECRET_KEY=change-me-too-for-production

# How long a login token lasts, in seconds, before the app quietly refreshes it (default 15 minutes).
JWT_ACCESS_TOKEN_EXPIRES=900

# How long you stay logged in without using the app, in days (default 30).
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# The database. Leave empty locally to use a SQLite file (backend/instance/collabu_dev.db).
# Render fills this in with its Postgres address.
# DATABASE_URL=postgresql://username:password@localhost:5432/collabu

# Where the frontend runs. Used for links in emails and, in production, as the only site
# allowed to call the API (CORS).
FRONTEND_URL=http://localhost:5173

# Extra sites allowed to call the API, comma separated. Only used in development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where emails go: console (print them in this terminal) or resend (really send them).
EMAIL_BACKEND=console

# Only for EMAIL_BACKEND=resend. The API key from resend.com, and the address emails come from
# (it must be on a domain you verified in Resend).
# RESEND_API_KEY=re_...
# EMAIL_FROM=CollabU <hello@yourdomain.com>

# Where uploaded files go: local (a folder on this computer) or s3 (Supabase Storage, or any
# S3 compatible storage). Render wipes its disk on every deploy, so production needs s3.
STORAGE_BACKEND=local

# Only for STORAGE_BACKEND=local. Defaults to backend/uploads.
# UPLOAD_FOLDER=/absolute/path/to/uploads

# Only for STORAGE_BACKEND=s3. From Supabase: Project Settings > Storage > S3 Connection.
# S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
# S3_REGION=us-east-1
# S3_BUCKET=collabu-files
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...

# A shared password that lets the daily GitHub Action ask the API to send the digest emails.
# Any long random string; put the same value in the GitHub repository secret DIGEST_TOKEN.
# DIGEST_TOKEN=...
